// filepath: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Plan {
  FREE
  PREMIUM
}

enum LinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum PayoutMethod {
  BKASH
  BANK
}

enum ServiceCategory {
  WEB_DEVELOPMENT
  GRAPHIC_DESIGN
  DATA_ENTRY
  CONSULTING
  COPYWRITING
  VIDEO_EDITING
  OTHER
}

enum DocumentType {
  CONTRACT
  DELIVERY_PROOF
  ID_PROOF
  TAX_DOCUMENT
  BUSINESS_LICENSE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputeReason {
  CLIENT_NOT_PAID
  SERVICE_NOT_DELIVERED
  OVERCHARGED
  DUPLICATE_CHARGE
  UNAUTHORIZED_CHARGE
  OTHER
}

enum KycLevel {
  UNVERIFIED
  BASIC
  FULL
}

enum NotificationType {
  PAYMENT_RECEIVED
  PAYOUT_PROCESSED
  PAYOUT_COMPLETED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  ACCOUNT_LOCKED
  WELCOME
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  LOGIN
  PAYMENT_LINK_CREATED
  PAYMENT_LINK_UPDATED
  PAYMENT_LINK_CANCELLED
  PAYMENT_LINK_DELETED
  PAYMENT_LINK_SHARED
  TRANSACTION_CREATED
  TRANSACTION_SUCCESS
  TRANSACTION_FAILED
  PAYOUT_INITIATED
  PAYOUT_COMPLETED
  PAYOUT_FAILED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  ADMIN_PLAN_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  LOGIN_BLOCKED
  LOGIN_FAILED
  LOGIN_ATTEMPTS_RESET
  AUDIT_LOG_CLEANUP
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  DISPUTE_CREATED
  DISPUTE_UPDATED
  DISPUTE_RESOLVED
  RISK_FLAG_ADDED
  RISK_FLAG_REMOVED
  KYC_LEVEL_CHANGED
}

// ============ MODELS ============

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  name                String?
  phone               String?   @unique
  bkashNumber         String?
  bankAccount         String?
  bankName            String?
  bankRouting         String?
  plan                Plan      @default(FREE)
  isAdmin             Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  nid                 String?   @db.Text   // Encrypted at application level using AES-256-GCM
  tin                 String?   @db.Text   // Encrypted at application level using AES-256-GCM
  emailVerified       DateTime?
  bkashVerified       Boolean   @default(false)
  bankVerified        Boolean   @default(false)
  kycLevel            KycLevel  @default(UNVERIFIED)
  riskScore           Int       @default(0)
  riskFlags           String[]  @default([])
  businessName        String?
  businessAddress     String?
  businessLogo       String?
  defaultPaymentTerms String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  paymentLinks        PaymentLink[]
  transactions        Transaction[]
  payouts             Payout[]
  auditLogs           AuditLog[]
  sessions            Session[]
  invoices            Invoice[]
  pendingSubscriptions PendingSubscription[]
  documents           Document[]
  disputes            Dispute[]
  notificationPrefs   NotificationPreference[]

  @@index([email])
  @@index([phone])
  @@index([isAdmin])
  @@index([kycLevel])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
}

model PaymentLink {
  id              String          @id @default(cuid())
  userId          String
  amount          Int
  description     String          @db.VarChar(500)
  customerName    String?
  customerEmail   String?
  customerMobile  String?
  serviceCategory ServiceCategory @default(OTHER)
  status          LinkStatus      @default(PENDING)
  aamarPayId      String?
  aamarPayUrl     String?
  shareUrl        String          @unique
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([shareUrl])
  @@index([status])
  @@index([serviceCategory])
}

model Transaction {
  id              String            @id @default(cuid())
  paymentLinkId   String
  userId          String
  amount          Int
  platformFee     Int
  gatewayFee      Int
  netAmount       Int
  status          TransactionStatus @default(PENDING)
  aamarPayTxnId   String?
  aamarPayFees    String?
  metadata        String?
  payoutStatus    PayoutStatus      @default(PENDING)
  payoutId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  paymentLink PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payout     Payout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([paymentLinkId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  userId      String
  amount      Int
  method      PayoutMethod
  status      PayoutStatus @default(PENDING)
  bkashTxnId  String?
  bankTxnId   String?
  processedAt DateTime?
  failureMsg  String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([processed])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  action    AuditAction
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  transactionId String?
  invoiceNumber String @unique
  pdfUrl      String?
  status      String   @default("PENDING")
  amount      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceNumber])
}

model PendingSubscription {
  id          String   @id @default(cuid())
  userId      String
  plan        Plan
  amount      Int
  status      String   @default("PENDING")
  aamarPayId  String?
  expiresAt   DateTime
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aamarPayId])
  @@index([status])
}

model Document {
  id          String      @id @default(cuid())
  userId      String
  type        DocumentType
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  verified    Boolean     @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([verified])
}

model Dispute {
  id              String        @id @default(cuid())
  transactionId   String
  userId          String
  reason          DisputeReason
  description     String
  status          DisputeStatus @default(OPEN)
  amount          Int
  evidenceUrls    String[]      @default([])
  adminNotes      String?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

model NotificationPreference {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  emailEnabled Boolean         @default(true)
  smsEnabled   Boolean         @default(false)
  pushEnabled  Boolean         @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}
